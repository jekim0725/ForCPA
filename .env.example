# OpenDART에서 발급받은 인증키를 입력하세요.
DART_API_KEY=

# Google AI Studio에서 발급받은 키입니다. 공개 앱에서는 Streamlit Secrets에 저장하세요.
GEMINI_API_KEY=
# 무료 등급을 지원하는 기본 모델입니다. 필요한 경우에만 변경하세요.
GEMINI_MODEL=gemini-3.1-flash-lite

# Streamlit Cloud에서는 아래 두 값을 사용하면 DART 요청을 Vercel 서울 함수로 보냅니다.
# DART_PROXY_URL=https://내프로젝트.vercel.app/api/dart_proxy
# DART_PROXY_TOKEN=임의의_긴_비밀문자열
